{
  "providers": [
    {
      "name": "anthropic",
      "families": ["claude-fable", "claude-opus", "claude-sonnet", "claude-haiku"],
      "stripPrefix": "claude-"
    },
    {
      "name": "google-antigravity",
      "families": ["gemini", "claude-opus", "claude-sonnet", "gpt-oss"],
      "stripPrefix": "claude-",
      "namePrefix": "Google ",
      "namePrefixSkip": ["gemini"]
    }
  ],
  "ensureDisabled": ["gpt-5.3-codex-spark"],
  "config": {
    "modelDiscovery.newModelPolicy": "on",
    "catalogAutoRefresh": { "enabled": true, "intervalMinutes": 15 },
    "showCodexSparkQuota": false,
    "providers.google-antigravity.alias": "agy",
    "providers.google-antigravity.googleMode": "cloud-code-assist"
  }
}
